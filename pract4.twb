      <column caption='TOTAL_SCORE' datatype='integer' name='[Calculation_1481628076339200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[harmony_score]+[interpretative_ability_score]+[peer_collaboration_score]+[scale_rhythm_score]+[theory_pretest_score]' />
      </column>
      <column caption='SUM_THEORY_PRETEST_SCORE LEARNING_STYLE INCLUDE LOD' datatype='integer' name='[Calculation_1481628078706690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [learning_style] : SUM([theory_pretest_score])}' />
      </column>
      <column aggregation='Attribute' caption='AVG_PEER_COLLAB_SCORE PACE_OF_LEARNING EXCLUDE LOD' datatype='real' name='[Calculation_1481628079284227]' role='measure' type='quantitative'>
